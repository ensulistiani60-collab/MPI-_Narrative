  <!-- ===================================================================== -->
  <!-- JAVASCRIPT APPLICATION LOGIC, AUDIO ENGINE, SVG ARTWORK & CONTENT     -->
  <!-- ===================================================================== -->
  <script>
    /* ---------------------------------------------------------------------
       1. STATE MANAGEMENT & LOCALSTORAGE PERSISTENCE
    --------------------------------------------------------------------- */
    const STORAGE_KEY = 'mpi_narrative_endang_2026_v1';

    const DEFAULT_STATE = {
      currentView: 'landing',
      soundEnabled: true,
      speechRate: 1.0,
      visitedSections: {
        landing: true,
        menu: false,
        materi: false,
        simulasi: false,
        praktikum: false,
        game: false,
        lkpd: false,
        evaluasi: false,
        developer: false
      },
      materiStep: 0,
      materiQuizDone: {},
      simulasiPart: 0,
      simulasiAnswers: {},
      praktikumStep: 0,
      praktikumData: {
        p1: { char: '', time: '', place: '', checked: false },
        p2: { choice: '', checked: false },
        p3: { choice: '', checked: false },
        p4: { choice: '', checked: false },
        p5: { verbs: [], checked: false },
        p6: { title: '', orientation: '', complication: '', resolution: '', moral: '', saved: false }
      },
      gameScores: {
        game1: 0,
        game2: 0,
        game3: 0,
        game4: 0,
        game5: 0
      },
      lkpdData: {
        name: '',
        studentClass: 'XI',
        date: new Date().toISOString().split('T')[0],
        q2_char: '',
        q3_setting: '',
        q4_m1: '',
        q4_m2: '',
        q4_m3: '',
        q5_v1: '',
        q5_v2: '',
        q6_moral: '',
        q7_story: '',
        checked: false,
        autoScore: 0
      },
      evalState: {
        submitted: false,
        score: 0,
        answers: {},
        timeLeft: 1800 // 30 minutes
      },
      reflection: {
        q1: '',
        q2: '',
        q3: '',
        q4: '4 - Very Confident',
        savedAt: ''
      }
    };

    let appState = loadState();

    function loadState() {
      try {
        const raw = localStorage.getItem(STORAGE_KEY);
        if (!raw) return JSON.parse(JSON.stringify(DEFAULT_STATE));
        const parsed = JSON.parse(raw);
        return {
          ...JSON.parse(JSON.stringify(DEFAULT_STATE)),
          ...parsed,
          visitedSections: { ...DEFAULT_STATE.visitedSections, ...(parsed.visitedSections || {}) },
          praktikumData: { ...DEFAULT_STATE.praktikumData, ...(parsed.praktikumData || {}) },
          gameScores: { ...DEFAULT_STATE.gameScores, ...(parsed.gameScores || {}) },
          lkpdData: { ...DEFAULT_STATE.lkpdData, ...(parsed.lkpdData || {}) },
          evalState: { ...DEFAULT_STATE.evalState, ...(parsed.evalState || {}) },
          reflection: { ...DEFAULT_STATE.reflection, ...(parsed.reflection || {}) }
        };
      } catch (e) {
        return JSON.parse(JSON.stringify(DEFAULT_STATE));
      }
    }

    function saveState() {
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(appState));
      } catch (e) {
        console.warn('LocalStorage save warning:', e);
      }
      updateProgressUI();
    }

    function calculateProgressPercent() {
      let points = 0;
      const total = 10;
      if (appState.visitedSections.materi) points += 1;
      if (Object.keys(appState.materiQuizDone).length >= 3) points += 1;
      if (appState.visitedSections.simulasi) points += 1;
      if (Object.keys(appState.simulasiAnswers).length >= 3) points += 1;
      if (appState.visitedSections.praktikum) points += 1;
      if (appState.praktikumData.p6.saved || appState.praktikumData.p1.checked) points += 1;
      const totalGameScore = Object.values(appState.gameScores).reduce((a, b) => a + b, 0);
      if (totalGameScore > 0) points += 1;
      if (appState.lkpdData.checked || appState.lkpdData.name) points += 1;
      if (appState.evalState.submitted) points += 1;
      if (appState.reflection.savedAt) points += 1;
      return Math.min(100, Math.round((points / total) * 100));
    }

    function updateProgressUI() {
      const pct = calculateProgressPercent();
      const textEl = document.getElementById('global-progress-text');
      const barEl = document.getElementById('global-progress-bar');
      if (textEl) textEl.textContent = pct + '%';
      if (barEl) barEl.style.width = pct + '%';
    }

    /* ---------------------------------------------------------------------
       2. AUDIO ENGINE: WEB SPEECH API + WEB AUDIO API SOUND EFFECTS
    --------------------------------------------------------------------- */
    const speechSupported = 'speechSynthesis' in window;
    let availableVoices = [];
    let lastSpeechPayload = null;
    let audioCtx = null;

    function initVoices() {
      if (!speechSupported) {
        const banner = document.getElementById('speech-fallback-banner');
        if (banner) banner.classList.remove('hidden');
        return;
      }
      availableVoices = window.speechSynthesis.getVoices();
    }

    if (speechSupported) {
      initVoices();
      window.speechSynthesis.onvoiceschanged = initVoices;
    } else {
      window.addEventListener('DOMContentLoaded', () => {
        const banner = document.getElementById('speech-fallback-banner');
        if (banner) banner.classList.remove('hidden');
      });
    }

    function getAudioContext() {
      if (!audioCtx) {
        const AudioContextClass = window.AudioContext || window.webkitAudioContext;
        if (AudioContextClass) audioCtx = new AudioContextClass();
      }
      if (audioCtx && audioCtx.state === 'suspended') {
        audioCtx.resume();
      }
      return audioCtx;
    }

    // Synthesized Sound Effects (Correct, Wrong, Win, Click)
    function playSFX(type) {
      if (!appState.soundEnabled) return;
      try {
        const ctx = getAudioContext();
        if (!ctx) return;
        const now = ctx.currentTime;

        if (type === 'correct') {
          [523.25, 659.25, 783.99].forEach((freq, idx) => {
            const osc = ctx.createOscillator();
            const gain = ctx.createGain();
            osc.type = 'triangle';
            osc.frequency.setValueAtTime(freq, now + idx * 0.09);
            gain.gain.setValueAtTime(0.16, now + idx * 0.09);
            gain.gain.exponentialRampToValueAtTime(0.001, now + idx * 0.09 + 0.28);
            osc.connect(gain);
            gain.connect(ctx.destination);
            osc.start(now + idx * 0.09);
            osc.stop(now + idx * 0.09 + 0.28);
          });
        } else if (type === 'wrong') {
          [240, 185].forEach((freq, idx) => {
            const osc = ctx.createOscillator();
            const gain = ctx.createGain();
            osc.type = 'sawtooth';
            osc.frequency.setValueAtTime(freq, now + idx * 0.14);
            gain.gain.setValueAtTime(0.12, now + idx * 0.14);
            gain.gain.exponentialRampToValueAtTime(0.001, now + idx * 0.14 + 0.25);
            osc.connect(gain);
            gain.connect(ctx.destination);
            osc.start(now + idx * 0.14);
            osc.stop(now + idx * 0.14 + 0.25);
          });
        } else if (type === 'win') {
          [523.25, 659.25, 783.99, 1046.50].forEach((freq, idx) => {
            const osc = ctx.createOscillator();
            const gain = ctx.createGain();
            osc.type = 'sine';
            osc.frequency.setValueAtTime(freq, now + idx * 0.11);
            gain.gain.setValueAtTime(0.18, now + idx * 0.11);
            gain.gain.exponentialRampToValueAtTime(0.001, now + idx * 0.11 + 0.4);
            osc.connect(gain);
            gain.connect(ctx.destination);
            osc.start(now + idx * 0.11);
            osc.stop(now + idx * 0.11 + 0.4);
          });
        } else if (type === 'click') {
          const osc = ctx.createOscillator();
          const gain = ctx.createGain();
          osc.type = 'sine';
          osc.frequency.setValueAtTime(620, now);
          gain.gain.setValueAtTime(0.06, now);
          gain.gain.exponentialRampToValueAtTime(0.001, now + 0.06);
          osc.connect(gain);
          gain.connect(ctx.destination);
          osc.start(now);
          osc.stop(now + 0.06);
        }
      } catch (err) {
        // Ignore audio errors safely
      }
    }

    function toggleSoundEnabled() {
      appState.soundEnabled = !appState.soundEnabled;
      if (!appState.soundEnabled) {
        stopSpeech();
      }
      updateSoundToggleUI();
      saveState();
      showToast(appState.soundEnabled ? 'Suara diaktifkan (Sound ON)' : 'Suara dinonaktifkan (Muted)', 'info');
    }

    function updateSoundToggleUI() {
      const btn = document.getElementById('btn-sound-toggle');
      const icon = document.getElementById('sound-icon');
      const label = document.getElementById('sound-label');
      const rateSel = document.getElementById('speech-rate-select');
      if (rateSel) rateSel.value = String(appState.speechRate);

      if (!btn) return;
      if (appState.soundEnabled) {
        btn.className = 'px-2.5 py-2 rounded-xl text-xs font-bold flex items-center gap-1.5 bg-emerald-500/20 text-emerald-300 border border-emerald-400/40 hover:bg-emerald-500/30 transition';
        icon.className = 'fa-solid fa-volume-high';
        label.textContent = 'Sound ON';
      } else {
        btn.className = 'px-2.5 py-2 rounded-xl text-xs font-bold flex items-center gap-1.5 bg-rose-500/20 text-rose-300 border border-rose-400/40 hover:bg-rose-500/30 transition';
        icon.className = 'fa-solid fa-volume-xmark';
        label.textContent = 'Sound OFF';
      }
    }

    function changeSpeechRate(val) {
      appState.speechRate = parseFloat(val) || 1.0;
      saveState();
      showToast(`Kecepatan suara: ${appState.speechRate}x`, 'info');
    }

    function pickBestVoice(langCode) {
      if (!availableVoices.length && speechSupported) {
        availableVoices = window.speechSynthesis.getVoices();
      }
      const prefix = langCode.toLowerCase().split('-')[0];
      let match = availableVoices.find(v => v.lang.toLowerCase() === langCode.toLowerCase());
      if (!match) match = availableVoices.find(v => v.lang.toLowerCase().startsWith(prefix));
      return match || null;
    }

    function speakText(text, lang = 'en-US', title = 'Audio Player', onEndCallback = null) {
      if (!appState.soundEnabled) {
        showToast('Suara sedang dimatikan. Klik tombol "Sound OFF" di atas untuk mengaktifkan.', 'warning');
        return;
      }
      if (!speechSupported) {
        showToast('Browser Anda tidak mendukung SpeechSynthesis API.', 'warning');
        return;
      }

      window.speechSynthesis.cancel();
      lastSpeechPayload = { text, lang, title, onEndCallback };

      const utterance = new SpeechSynthesisUtterance(text);
      utterance.lang = lang;
      utterance.rate = appState.speechRate;
      const voice = pickBestVoice(lang);
      if (voice) utterance.voice = voice;

      const bar = document.getElementById('floating-audio-bar');
      const titleEl = document.getElementById('audio-now-playing-title');
      const statusEl = document.getElementById('audio-now-playing-status');

      utterance.onstart = () => {
        if (bar) bar.classList.remove('hidden');
        if (titleEl) titleEl.textContent = title;
        if (statusEl) statusEl.textContent = `Playing (${lang}) • ${appState.speechRate}x`;
      };

      utterance.onend = () => {
        if (bar) bar.classList.add('hidden');
        if (typeof onEndCallback === 'function') onEndCallback();
      };

      utterance.onerror = () => {
        if (bar) bar.classList.add('hidden');
      };

      window.speechSynthesis.speak(utterance);
    }

    // Sentence-by-sentence Narrator with Highlighting
    let sentenceQueueCancelled = false;
    function speakSentencesWithHighlight(sentences, containerPrefix, lang = 'en-US', title = 'Story Narrator') {
      if (!appState.soundEnabled) {
        showToast('Aktifkan tombol Sound ON terlebih dahulu untuk mendengarkan cerita.', 'warning');
        return;
      }
      if (!speechSupported) {
        showToast('Browser tidak mendukung Text-to-Speech.', 'warning');
        return;
      }

      window.speechSynthesis.cancel();
      sentenceQueueCancelled = false;
      clearSentenceHighlights(containerPrefix, sentences.length);

      lastSpeechPayload = {
        isSentenceSequence: true,
        sentences,
        containerPrefix,
        lang,
        title
      };

      const bar = document.getElementById('floating-audio-bar');
      const titleEl = document.getElementById('audio-now-playing-title');
      const statusEl = document.getElementById('audio-now-playing-status');
      if (bar) bar.classList.remove('hidden');
      if (titleEl) titleEl.textContent = title;

      let index = 0;

      function speakNext() {
        if (sentenceQueueCancelled || index >= sentences.length) {
          clearSentenceHighlights(containerPrefix, sentences.length);
          if (bar) bar.classList.add('hidden');
          return;
        }

        clearSentenceHighlights(containerPrefix, sentences.length);
        const spanEl = document.getElementById(`${containerPrefix}-sent-${index}`);
        if (spanEl) {
          spanEl.classList.add('sentence-active');
        }
        if (statusEl) {
          statusEl.textContent = `Sentence ${index + 1} of ${sentences.length} (${appState.speechRate}x)`;
        }

        const utt = new SpeechSynthesisUtterance(sentences[index]);
        utt.lang = lang;
        utt.rate = appState.speechRate;
        const voice = pickBestVoice(lang);
        if (voice) utt.voice = voice;

        utt.onend = () => {
          index++;
          speakNext();
        };
        utt.onerror = () => {
          clearSentenceHighlights(containerPrefix, sentences.length);
          if (bar) bar.classList.add('hidden');
        };

        window.speechSynthesis.speak(utt);
      }

      speakNext();
    }

    function clearSentenceHighlights(prefix, count) {
      for (let i = 0; i < count; i++) {
        const el = document.getElementById(`${prefix}-sent-${i}`);
        if (el) el.classList.remove('sentence-active');
      }
    }

    function pauseSpeech() {
      if (speechSupported && window.speechSynthesis.speaking) {
        window.speechSynthesis.pause();
        const statusEl = document.getElementById('audio-now-playing-status');
        if (statusEl) statusEl.textContent = 'Paused';
      }
    }

    function resumeSpeech() {
      if (speechSupported && window.speechSynthesis.paused) {
        window.speechSynthesis.resume();
        const statusEl = document.getElementById('audio-now-playing-status');
        if (statusEl) statusEl.textContent = 'Resumed';
      }
    }

    function stopSpeech() {
      sentenceQueueCancelled = true;
      if (speechSupported) {
        window.speechSynthesis.cancel();
      }
      document.querySelectorAll('.sentence-active').forEach(el => el.classList.remove('sentence-active'));
      const bar = document.getElementById('floating-audio-bar');
      if (bar) bar.classList.add('hidden');
    }

    function replaySpeech() {
      if (!lastSpeechPayload) return;
      if (lastSpeechPayload.isSentenceSequence) {
        speakSentencesWithHighlight(
          lastSpeechPayload.sentences,
          lastSpeechPayload.containerPrefix,
          lastSpeechPayload.lang,
          lastSpeechPayload.title
        );
      } else {
        speakText(lastSpeechPayload.text, lastSpeechPayload.lang, lastSpeechPayload.title, lastSpeechPayload.onEndCallback);
      }
    }

