          <i id="sound-icon" class="fa-solid fa-volume-high"></i>
          <span id="sound-label" class="hidden md:inline">Sound ON</span>
        </button>

        <!-- Speech Rate Selector -->
        <select id="speech-rate-select" onchange="changeSpeechRate(this.value)" aria-label="Kecepatan Suara" class="bg-navy-800 text-amber-300 border border-amber-400/30 rounded-xl px-2 py-2 text-xs font-semibold focus:outline-none focus:border-amber-400">
          <option value="0.75">0.75x Slow</option>
