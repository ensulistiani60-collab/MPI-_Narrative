    function checkPraktikum(num) {
      const p = appState.praktikumData;
      if (num === 1) {
        p.p1.char = (document.getElementById('p1-char')?.value || '').trim();
        p.p1.time = (document.getElementById('p1-time')?.value || '').trim();
        p.p1.place = (document.getElementById('p1-place')?.value || '').trim();
        p.p1.checked = true;
        const ok = p.p1.char.toLowerCase().includes('raka') &&
                   (p.p1.time.toLowerCase().includes('night') || p.p1.time.toLowerCase().includes('stormy')) &&
                   (p.p1.place.toLowerCase().includes('lighthouse') || p.p1.place.toLowerCase().includes('island'));
        playSFX(ok ? 'correct' : 'warning');
        showToast(ok ? 'Luar biasa! Identifikasi tokoh, waktu, dan tempat sangat tepat.' : 'Jawaban diperiksa. Bandingkan dengan kunci pembahasan di bawah.', ok ? 'success' : 'info');
      } else if (num === 2) {
        const val = document.querySelector('input[name="p2-opt"]:checked')?.value || '';
        if (!val) { showToast('Pilih salah satu paragraf terlebih dahulu.', 'warning'); return; }
        p.p2.choice = val;
        p.p2.checked = true;
        playSFX(val === 'A' ? 'correct' : 'wrong');
        showToast(val === 'A' ? 'Tepat! Paragraf A adalah Orientation.' : 'Belum tepat, perhatikan paragraf yang memperkenalkan tokoh dan tempat.', val === 'A' ? 'success' : 'error');
      } else if (num === 3) {
        const val = document.querySelector('input[name="p3-opt"]:checked')?.value || '';
        if (!val) { showToast('Pilih salah satu paragraf terlebih dahulu.', 'warning'); return; }
        p.p3.choice = val;
        p.p3.checked = true;
        playSFX(val === 'B' ? 'correct' : 'wrong');
        showToast(val === 'B' ? 'Benar! Paragraf B adalah Complication (masalah muncul).' : 'Kurang tepat, cari paragraf yang memuat krisis.', val === 'B' ? 'success' : 'error');
      } else if (num === 4) {
        const val = document.querySelector('input[name="p4-opt"]:checked')?.value || '';
        if (!val) { showToast('Pilih salah satu paragraf terlebih dahulu.', 'warning'); return; }
        p.p4.choice = val;
        p.p4.checked = true;
        playSFX(val === 'C' ? 'correct' : 'wrong');
        showToast(val === 'C' ? 'Sempurna! Paragraf C adalah Resolution.' : 'Kurang tepat, cari paragraf penyelesaian masalah.', val === 'C' ? 'success' : 'error');
      } else if (num === 5) {
        const checkedBoxes = Array.from(document.querySelectorAll('input[name="p5-verb"]:checked')).map(el => el.value);
        p.p5.verbs = checkedBoxes;
        p.p5.checked = true;
        const target = ['climbed', 'repaired', 'guided'];
        const allRight = target.every(t => checkedBoxes.includes(t)) && checkedBoxes.length === 3;
        playSFX(allRight ? 'correct' : 'wrong');
