      const msg = "Welcome to Explore the World of Narrative Text, an interactive English learning media for Grade Eleven Vocational High School, SMK Perintis Adiluhur, developed by Endang Sulistiani. Click Start Learning to begin your adventure!";
      speakText(msg, 'en-US', 'Welcome Voice • SMK Perintis Adiluhur');
