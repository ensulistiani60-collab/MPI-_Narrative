      if (!q || appState.evalState.submitted) return;
      if (q.type === 'sa' || q.type === 'writing') {
        const el = document.getElementById(`eval-input-${q.id}`);
        if (el) {
          appState.evalState.answers[q.id] = el.value;
          saveState();
        }
      }
    }

    function selectEvalAnswer(qId, val) {
      if (appState.evalState.submitted) return;
      playSFX('click');
      appState.evalState.answers[qId] = val;
      saveState();
      renderCurrentView();
    }

    function confirmSubmitEvaluasi() {
      saveCurrentEvalInput();
      const answeredCount = Object.keys(appState.evalState.answers).filter(k => String(appState.evalState.answers[k]).trim() !== '').length;
      showCustomConfirm(
        'Submit Evaluasi Akhir',
        `Anda telah menjawab ${answeredCount} dari ${EVAL_QUESTIONS.length} soal. Apakah Anda yakin ingin mengakhiri tes dan melihat nilai?`,
        () => finalizeEvaluasiSubmission()
      );
    }

    function finalizeEvaluasiSubmission() {
      saveCurrentEvalInput();
      let correctObj = 0;
      const totalObj = 25; // 10 MC + 5 TF + 5 Match + 5 SA

      EVAL_QUESTIONS.forEach(q => {
        if (q.type === 'writing') return;
        const userAns = (appState.evalState.answers[q.id] || '').trim();
        if (q.type === 'sa') {
          const lower = userAns.toLowerCase();
          if (q.keywords.some(kw => lower.includes(kw))) correctObj++;
        } else {
          if (userAns === q.correct) correctObj++;
        }
      });

      const objScore = Math.round((correctObj / totalObj) * 100);
      appState.evalState.score = objScore;
      appState.evalState.submitted = true;
      saveState();
      playSFX('win');
      renderCurrentView();
    }

