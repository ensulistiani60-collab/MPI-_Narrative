  </div>

  <!-- TOP NAVIGATION BAR (Visible on all pages except full-bleed cover toggle, kept accessible) -->
  <header id="top-navbar" class="sticky top-0 z-40 bg-gradient-to-r from-navy-950 via-navy-900 to-royal-900 text-white shadow-lg border-b border-amber-500/30">
    <div class="max-w-7xl mx-auto px-3 sm:px-6 py-2.5 flex flex-wrap items-center justify-between gap-2">
