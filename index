          <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-amber-400 to-amber-600 text-navy-950 flex items-center justify-center font-extrabold text-lg shadow-md group-hover:scale-105 transition">
            <i class="fa-solid fa-book-open-reader"></i>
          </div>
          <div class="hidden sm:block">
            <div class="text-xs font-bold tracking-wider text-amber-400 uppercase">SMK Perintis Adiluhur</div>
            <div class="text-sm font-extrabold leading-tight text-white">Narrative Text • XI Fase F</div>
          </div>
        </button>
      </div>

      <!-- Progress Bar Indicator -->
