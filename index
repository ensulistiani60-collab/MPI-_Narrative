    function movePuzzleItem(idx, dir) {
      const target = idx + dir;
      if (target < 0 || target >= gameSession.order.length) return;
      playSFX('click');
      const temp = gameSession.order[idx];
      gameSession.order[idx] = gameSession.order[target];
      gameSession.order[target] = temp;
      renderCurrentView();
    }

    function submitGame1() {
      const expected = ['orientation', 'complication', 'resolution', 'reorientation'];
      let correctCount = 0;
      gameSession.order.forEach((item, idx) => {
        if (item.id === expected[idx]) correctCount++;
      });
      const score = correctCount * 25;
      gameSession.score = score;
      gameSession.finished = true;
      appState.gameScores.game1 = Math.max(appState.gameScores.game1, score);
      saveState();
      playSFX(score >= 75 ? 'win' : 'wrong');
      renderCurrentView();
    }

    // Game 2 Actions
    function revealNextClue() {
      if (gameSession.clueCount < 3) {
        playSFX('click');
        gameSession.clueCount++;
        renderCurrentView();
      }
    }

    function answerGame2(choice) {
      const q = gameSession.questions[gameSession.qIdx];
      if (choice === q.answer) {
        const pts = gameSession.clueCount === 1 ? 35 : (gameSession.clueCount === 2 ? 25 : 20);
        gameSession.score += pts;
        playSFX('correct');
        showToast(`Benar! +${pts} poin`, 'success');
      } else {
        playSFX('wrong');
        showToast(`Salah! Jawabannya adalah ${q.answer}.`, 'error');
      }
      if (gameSession.qIdx + 1 < gameSession.questions.length) {
        gameSession.qIdx++;
        gameSession.clueCount = 1;
      } else {
        gameSession.score = Math.min(100, gameSession.score);
        gameSession.finished = true;
        appState.gameScores.game2 = Math.max(appState.gameScores.game2, gameSession.score);
        saveState();
        playSFX('win');
      }
      renderCurrentView();
    }

    // Game 3 Actions
    function clickWordHunterToken(idx) {
      if (gameSession.finished) return;
      const token = gameSession.tokens[idx];
      if (token.isPast) {
        if (!gameSession.found.includes(idx)) {
          gameSession.found.push(idx);
          playSFX('correct');
          showToast(`Ditemukan: "${token.text}" (Simple Past Verb)`, 'success');
        }
        if (gameSession.found.length === 4) {
          const score = Math.max(40, 100 - gameSession.wrongClicks * 15);
          gameSession.score = score;
          gameSession.finished = true;
          appState.gameScores.game3 = Math.max(appState.gameScores.game3, score);
          saveState();
          playSFX('win');
        }
      } else {
        gameSession.wrongClicks++;
        playSFX('wrong');
        showToast(`"${token.text}" bukan kata kerja Simple Past Tense.`, 'error');
      }
      renderCurrentView();
    }

