    function playFullLionStoryAudio() {
      const allSentences = [];
      LION_STORY_PARTS.forEach((p, pIdx) => {
        p.sentencesEN.forEach((s) => allSentences.push(s));
      });
      // Play sequentially across parts
      if (!appState.soundEnabled) {
        showToast('Aktifkan Sound ON terlebih dahulu.', 'warning');
        return;
      }
      if (!speechSupported) {
        showToast('SpeechSynthesis tidak didukung browser ini.', 'warning');
        return;
      }
      window.speechSynthesis.cancel();
      sentenceQueueCancelled = false;

      let flatList = [];
      LION_STORY_PARTS.forEach((part, pIdx) => {
        part.sentencesEN.forEach((sent, sIdx) => {
          flatList.push({ text: sent, elemId: `sim-part-${pIdx}-sent-${sIdx}` });
        });
      });

      lastSpeechPayload = {
        text: flatList.map(f => f.text).join(' '),
        lang: 'en-US',
        title: 'Full Story: The Lion and the Little Mouse'
      };

      const bar = document.getElementById('floating-audio-bar');
      const titleEl = document.getElementById('audio-now-playing-title');
      const statusEl = document.getElementById('audio-now-playing-status');
      if (bar) bar.classList.remove('hidden');
      if (titleEl) titleEl.textContent = 'Full Story: The Lion & The Little Mouse';

      let idx = 0;
      function nextFull() {
        document.querySelectorAll('.sentence-active').forEach(el => el.classList.remove('sentence-active'));
        if (sentenceQueueCancelled || idx >= flatList.length) {
          if (bar) bar.classList.add('hidden');
          return;
        }
        const item = flatList[idx];
        const el = document.getElementById(item.elemId);
        if (el) {
          el.classList.add('sentence-active');
          el.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }
        if (statusEl) statusEl.textContent = `Reading sentence ${idx + 1} / ${flatList.length}`;

        const utt = new SpeechSynthesisUtterance(item.text);
        utt.lang = 'en-US';
        utt.rate = appState.speechRate;
        const v = pickBestVoice('en-US');
        if (v) utt.voice = v;
        utt.onend = () => {
          idx++;
          nextFull();
        };
        utt.onerror = () => {
          if (bar) bar.classList.add('hidden');
        };
        window.speechSynthesis.speak(utt);
      }
      nextFull();
    }

