        <button onclick="navigateTo('menu')" class="px-3 py-2 rounded-xl bg-gradient-to-r from-royal-600 to-purple-700 hover:from-royal-500 hover:to-purple-600 text-white text-xs font-bold shadow transition flex items-center gap-1.5">
          <i class="fa-solid fa-grid-2 fa-table-cells-large text-amber-300"></i>
