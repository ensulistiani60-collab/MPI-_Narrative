    /* ---------------------------------------------------------------------
       6. VIEW RENDERING & NAVIGATION SYSTEM
    --------------------------------------------------------------------- */
    const ROUTE_ORDER = ['landing', 'menu', 'materi', 'simulasi', 'praktikum', 'game', 'lkpd', 'evaluasi', 'developer'];

    function navigateTo(viewName) {
      stopSpeech();
      playSFX('click');
      appState.currentView = viewName;
      if (appState.visitedSections.hasOwnProperty(viewName)) {
        appState.visitedSections[viewName] = true;
      }
      saveState();
      renderCurrentView();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function navigateStep(delta) {
      const idx = ROUTE_ORDER.indexOf(appState.currentView);
      if (idx === -1) {
        navigateTo('menu');
        return;
      }
      const nextIdx = Math.max(0, Math.min(ROUTE_ORDER.length - 1, idx + delta));
      navigateTo(ROUTE_ORDER[nextIdx]);
    }

    function renderCurrentView() {
      const main = document.getElementById('app-main');
      const bottomNav = document.getElementById('bottom-nav-bar');
      const view = appState.currentView;

      if (view === 'landing') {
        bottomNav.classList.add('hidden');
      } else {
        bottomNav.classList.remove('hidden');
      }

      switch (view) {
        case 'landing':
          main.innerHTML = renderLandingPage();
          break;
        case 'menu':
          main.innerHTML = renderMainMenuPage();
          break;
        case 'materi':
          main.innerHTML = renderMateriPage();
          break;
        case 'simulasi':
          main.innerHTML = renderSimulasiPage();
          break;
        case 'praktikum':
          main.innerHTML = renderPraktikumPage();
          break;
        case 'game':
          main.innerHTML = renderGameHubPage();
          break;
        case 'lkpd':
          main.innerHTML = renderLKPDPage();
          break;
        case 'evaluasi':
          main.innerHTML = renderEvaluasiPage();
          break;
        case 'developer':
          main.innerHTML = renderDeveloperPage();
          break;
        default:
          main.innerHTML = renderLandingPage();
      }
      updateProgressUI();
    }

