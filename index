      <button onclick="resumeSpeech()" title="Resume" class="w-8 h-8 rounded-lg bg-navy-800 hover:bg-emerald-500 hover:text-navy-950 flex items-center justify-center transition"><i class="fa-solid fa-play text-xs"></i></button>
      <button onclick="replaySpeech()" title="Replay" class="w-8 h-8 rounded-lg bg-navy-800 hover:bg-purple-500 flex items-center justify-center transition"><i class="fa-solid fa-rotate-right text-xs"></i></button>
      <button onclick="stopSpeech()" title="Stop" class="w-8 h-8 rounded-lg bg-rose-600/80 hover:bg-rose-600 flex items-center justify-center transition"><i class="fa-solid fa-stop text-xs"></i></button>
    </div>
  </div>

  <!-- MAIN DYNAMIC VIEWPORT -->
  <main id="app-main" class="flex-1 w-full">
    <!-- Views are rendered dynamically via JavaScript -->
  </main>

  <!-- PERSISTENT BOTTOM NAVIGATION (Back / Main Menu / Next) -->
  <footer id="bottom-nav-bar" class="hidden bg-white border-t border-slate-200 py-3 px-4 shadow-inner no-print">
    <div class="max-w-6xl mx-auto flex items-center justify-between gap-2">
      <button id="btn-nav-back" onclick="navigateStep(-1)" class="px-4 py-2.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-navy-900 font-bold text-sm flex items-center gap-2 transition">
        <i class="fa-solid fa-arrow-left text-royal-600"></i>
